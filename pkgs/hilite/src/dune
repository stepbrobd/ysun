(library
 (name hilite)
 (public_name hilite)
 (libraries textmate-language))

(data_only_dirs syntaxes)

; jsons.ml is generated, never checked in, so the grammars in syntaxes/ stay
; the single source of truth for what hilite highlights

(rule
 (target jsons.ml)
 (deps
  pp/pp.exe
  syntaxes/ocaml.interface.json
  syntaxes/ocaml.json
  syntaxes/dune.json
  syntaxes/shell.json
  syntaxes/opam.json
  syntaxes/diff.json
  syntaxes/go.json
  syntaxes/nix.json
  syntaxes/html.json
  syntaxes/toml.json)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let ocaml_interface =\n")
    (run ./pp/pp.exe syntaxes/ocaml.interface.json)
    (echo "\n\n")
    (echo "let ocaml =\n")
    (run ./pp/pp.exe syntaxes/ocaml.json)
    (echo "\n\n")
    (echo "let dune =\n")
    (run ./pp/pp.exe syntaxes/dune.json)
    (echo "\n\n")
    (echo "let shell =\n")
    (run ./pp/pp.exe syntaxes/shell.json)
    (echo "\n\n")
    (echo "let opam =\n")
    (run ./pp/pp.exe syntaxes/opam.json)
    (echo "\n\n")
    (echo "let diff =\n")
    (run ./pp/pp.exe syntaxes/diff.json)
    (echo "\n\n")
    (echo "let go =\n")
    (run ./pp/pp.exe syntaxes/go.json)
    (echo "\n\n")
    (echo "let nix =\n")
    (run ./pp/pp.exe syntaxes/nix.json)
    (echo "\n\n")
    (echo "let html =\n")
    (run ./pp/pp.exe syntaxes/html.json)
    (echo "\n\n")
    (echo "let toml =\n")
    (run ./pp/pp.exe syntaxes/toml.json)
    (echo "\n")))))
